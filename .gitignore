.vs/
.idea/
*.sln.DotSettings.user
*.VC.db
*.VC.opendb

# Plugin generated files
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/Developer/RiderLink/

# Build and log noise
*.log
*.tmp
*.cache

# Generated documentation outputs; authored Markdown under docs/ is tracked.

